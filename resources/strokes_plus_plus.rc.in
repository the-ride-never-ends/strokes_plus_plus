#include "@CMAKE_CURRENT_SOURCE_DIR@/resources/resource.h"
#include <winver.h>

IDI_STROKES_PLUS_PLUS ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/strokes_plus_plus_logo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Strokes++ contributors\0"
            VALUE "FileDescription", "Strokes++ mouse gesture application\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "StrokesPlusPlus\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Strokes++ contributors\0"
            VALUE "OriginalFilename", "StrokesPlusPlus.exe\0"
            VALUE "ProductName", "Strokes++\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
